# =============================================================================
# BACKEND (Render / Railway Environment Variables)
# =============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/aanur_textile?retryWrites=true&w=majority

# Option 1: Gmail SMTP (Sends real OTP & order emails to ANY email address in the world - No domain needed)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Option 2: Resend Email Configuration (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Aanur Textile <onboarding@resend.dev>

STORE_ADMIN_EMAIL=admin@example.com

# =============================================================================
# FRONTEND (Vercel Environment Variables)
# =============================================================================
VITE_STORE_ADMIN_EMAIL=admin@example.com
# Set to your Render backend URL (e.g. https://aanur-textile-backend.onrender.com)
VITE_API_BASE_URL=https://your-backend.onrender.com
