# MongoDB Atlas Connection URL (MERN Stack)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/aanur_textile?retryWrites=true&w=majority

# Resend Email Configuration (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Aanur Textile <onboarding@resend.dev>
STORE_ADMIN_EMAIL=admin@example.com


# Fast2SMS OTP Service (https://www.fast2sms.com/)
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
